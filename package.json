{
  "name": "elf-tokens",
  "version": "1.0.0",
  "description": "Compare Figma design tokens against the tokens in your codebase and surface drift as a PR comment.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nonyonah/elf.git"
  },
  "keywords": [
    "figma",
    "design-tokens",
    "design-systems",
    "tailwind",
    "css",
    "ci",
    "cli",
    "drift"
  ],
  "bin": {
    "elf-tokens": "bin/elf-tokens.js",
    "elf": "bin/elf-tokens.js"
  },
  "exports": {
    ".": "./src/core/index.ts",
    "./core": "./src/core/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "fixtures",
    "worker",
    "plugin",
    "elf.config.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check-drift": "tsx src/cli.ts",
    "check-drift:sample": "tsx src/cli.ts --sample",
    "test": "node --import tsx --test test/diff.test.ts test/report.test.ts test/webhook.test.ts test/source.test.ts test/components.test.ts test/deprecations.test.ts test/status.test.ts test/modes.test.ts test/notify.test.ts test/core-purity.test.ts test/core-hash.test.ts test/push.test.ts test/remote-config.test.ts",
    "test:worker": "node worker/test.mjs",
    "notify:drill": "node test/notify-drill.mjs",
    "build:plugin": "tsc -p plugin/tsconfig.json",
    "build:bridge-plugin": "tsc -p bridge-plugin/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck",
    "mcp:test": "npm --prefix mcp test",
    "mcp:typecheck": "npm --prefix mcp run typecheck",
    "mcp:verify-plugin": "npm --prefix mcp run verify:plugin",
    "batch:test": "npm --prefix batch test",
    "batch:typecheck": "npm --prefix batch run typecheck"
  },
  "dependencies": {
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.134.0",
    "@types/node": "^20.14.0",
    "typescript": "^5.6.3"
  }
}
