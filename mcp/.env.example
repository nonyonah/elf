# Copy to mcp/.env and fill in — the server loads mcp/.env automatically at
# startup (real environment variables win over this file).
# This secret signs plugin session secrets and guards /control + HTTP.
# It is not pasted into the plugin: pair with the one-time code instead.
# Never commit the filled-in file.
ELF_MCP_TOKEN=
ELF_MCP_PORT=8765
ELF_MCP_TIMEOUT_MS=10000
# Port for `npm run start:http` (web clients via a tunnel). Tunnel this one.
ELF_MCP_HTTP_PORT=8788