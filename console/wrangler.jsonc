{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elf-console",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "elf-console",
      "database_id": "5c64240d-2115-47ca-9274-c3c7723cddf8",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "CONSOLE_ORIGIN": "https://console.elf.dev",
    "CLERK_AUTHORIZED_PARTIES": "https://console.elf.dev"
  },
  "workers_dev": true,
  "triggers": {
    "crons": ["* * * * *", "*/15 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
