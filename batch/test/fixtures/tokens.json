{
  "color": {
    "surface": { "base": { "value": "#ffffff", "type": "color" } },
    "onSurface": { "base": { "value": "#111827", "type": "color" } },
    "primary": { "500": { "value": "#6366f1", "type": "color" } }
  },
  "space": {
    "2": { "value": 8, "type": "dimension" },
    "4": { "value": 16, "type": "dimension" }
  },
  "radius": {
    "md": { "value": 12, "type": "dimension" }
  },
  "fontFamily": {
    "sans": { "value": "Inter", "type": "fontFamilies" }
  },
  "fontSize": {
    "body": { "value": 14, "type": "fontSizes" }
  },
  "semantic": {
    "color": {
      "surface": {
        "value": "{color.surface.base}",
        "modes": { "Dark": "{color.onSurface.base}" }
      },
      "text": { "value": "{color.onSurface.base}" }
    }
  },
  "textStyles": {
    "Body/Regular": {
      "fontFamily": "{fontFamily.sans}",
      "fontSize": "{fontSize.body}",
      "lineHeight": { "percent": 150 }
    }
  },
  "effectStyles": {
    "Elevation/1": {
      "effects": [
        { "type": "DROP_SHADOW", "color": "#00000040", "offset": { "x": 0, "y": 2 }, "radius": 4, "spread": 0 }
      ]
    }
  }
}
