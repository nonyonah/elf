{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "types": []
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.jsx"],
  "exclude": ["**/*.vue", "**/*.svelte", "**/*.astro"]
}
